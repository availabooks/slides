{
  "name": "ai-slides-hoster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "slides": "./bin/slides.mjs"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "build:web": "vite build --config web/vite.config.ts",
    "build:types": "tsc -p tsconfig.json --noEmit",
    "build": "npm run build:web && npm run build:types",
    "preview": "serve dist",
    "slides": "node bin/slides.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@workos-inc/node": "^7.2.0",
    "fflate": "^0.8.2",
    "mime-types": "^2.1.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wrangler": "^3.78.0"
  }
}
